# Exemplo de variÃ¡veis de ambiente do MGT Engenharia.
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# NUNCA coloque senhas ou chaves reais neste arquivo de exemplo.

# --- NÃºcleo do Django ---
# Gere uma chave prÃ³pria em produÃ§Ã£o (o Render gera automaticamente).
SECRET_KEY=unsafe-local-only
# Use True apenas em desenvolvimento local.
DEBUG=True
# Lista separada por vÃ­rgulas dos hosts permitidos.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiÃ¡veis para CSRF (ex.: https://seu-dominio.com).
CSRF_TRUSTED_ORIGINS=

# --- Banco de dados ---
# Em produÃ§Ã£o informe a Internal Database URL do PostgreSQL do Render.
# Sem esta variÃ¡vel, Ã© usado um SQLite local (db.sqlite3).
DATABASE_URL=

# --- E-mail ---
# Backend de console imprime os e-mails no terminal (padrÃ£o local).
# Em produÃ§Ã£o use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MGT Engenharia <nao-responda@mgt.local>

# E-mail que recebe as notificaÃ§Ãµes de novos leads da landing page.
MGT_LEAD_NOTIFICATION_EMAIL=mgtengenharia@ia.com.br