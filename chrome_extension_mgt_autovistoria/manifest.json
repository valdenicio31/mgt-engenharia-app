{
  "manifest_version": 3,
  "name": "MGT Autovistoria Assistida",
  "version": "1.0.4",
  "description": "Motor 2.0: preenchimento robusto, validação do endereço oficial, CAPTCHA manual e importação inteligente dos comunicados.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://autovistoria.rio.rj.gov.br/*",
    "https://mgt-engenharia-homologacao.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mgt-engenharia-homologacao.onrender.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "mgt-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://autovistoria.rio.rj.gov.br/*"
      ],
      "js": [
        "portal-content.js"
      ],
      "css": [
        "portal.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MGT Autovistoria Assistida"
  }
}
